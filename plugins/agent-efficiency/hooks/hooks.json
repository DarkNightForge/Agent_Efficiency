{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT}/hooks/agent_efficiency_hook.py\"",
            "commandWindows": "powershell.exe -NoProfile -NonInteractive -ExecutionPolicy Bypass -File \"${PLUGIN_ROOT}/scripts/launch_python.ps1\" -Script \"${PLUGIN_ROOT}/hooks/agent_efficiency_hook.py\"",
            "statusMessage": "Loading Agent Efficiency mode",
            "additionalContextLimit": 700
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT}/hooks/agent_efficiency_hook.py\"",
            "commandWindows": "powershell.exe -NoProfile -NonInteractive -ExecutionPolicy Bypass -File \"${PLUGIN_ROOT}/scripts/launch_python.ps1\" -Script \"${PLUGIN_ROOT}/hooks/agent_efficiency_hook.py\"",
            "statusMessage": "Starting task timer",
            "additionalContextLimit": 900
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT}/hooks/agent_efficiency_hook.py\"",
            "commandWindows": "powershell.exe -NoProfile -NonInteractive -ExecutionPolicy Bypass -File \"${PLUGIN_ROOT}/scripts/launch_python.ps1\" -Script \"${PLUGIN_ROOT}/hooks/agent_efficiency_hook.py\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT}/hooks/agent_efficiency_hook.py\"",
            "commandWindows": "powershell.exe -NoProfile -NonInteractive -ExecutionPolicy Bypass -File \"${PLUGIN_ROOT}/scripts/launch_python.ps1\" -Script \"${PLUGIN_ROOT}/hooks/agent_efficiency_hook.py\""
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT}/hooks/agent_efficiency_hook.py\"",
            "commandWindows": "powershell.exe -NoProfile -NonInteractive -ExecutionPolicy Bypass -File \"${PLUGIN_ROOT}/scripts/launch_python.ps1\" -Script \"${PLUGIN_ROOT}/hooks/agent_efficiency_hook.py\""
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT}/hooks/agent_efficiency_hook.py\"",
            "commandWindows": "powershell.exe -NoProfile -NonInteractive -ExecutionPolicy Bypass -File \"${PLUGIN_ROOT}/scripts/launch_python.ps1\" -Script \"${PLUGIN_ROOT}/hooks/agent_efficiency_hook.py\""
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT}/hooks/agent_efficiency_hook.py\"",
            "commandWindows": "powershell.exe -NoProfile -NonInteractive -ExecutionPolicy Bypass -File \"${PLUGIN_ROOT}/scripts/launch_python.ps1\" -Script \"${PLUGIN_ROOT}/hooks/agent_efficiency_hook.py\""
          }
        ]
      }
    ],
    "PostCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT}/hooks/agent_efficiency_hook.py\"",
            "commandWindows": "powershell.exe -NoProfile -NonInteractive -ExecutionPolicy Bypass -File \"${PLUGIN_ROOT}/scripts/launch_python.ps1\" -Script \"${PLUGIN_ROOT}/hooks/agent_efficiency_hook.py\""
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT}/hooks/agent_efficiency_hook.py\"",
            "statusMessage": "Saving task efficiency",
            "timeout": 10,
            "commandWindows": "powershell.exe -NoProfile -NonInteractive -ExecutionPolicy Bypass -File \"${PLUGIN_ROOT}/scripts/launch_python.ps1\" -Script \"${PLUGIN_ROOT}/hooks/agent_efficiency_hook.py\""
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT}/hooks/agent_efficiency_hook.py\"",
            "timeout": 3,
            "commandWindows": "powershell.exe -NoProfile -NonInteractive -ExecutionPolicy Bypass -File \"${PLUGIN_ROOT}/scripts/launch_python.ps1\" -Script \"${PLUGIN_ROOT}/hooks/agent_efficiency_hook.py\""
          }
        ]
      }
    ]
  }
}
